@model IEnumerable<WtLab4Korbut.Models.Account>

@{
    ViewData["Title"] = "Список счетов";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <div>
        <h1 class="display-6 text-white mb-1">Список счетов</h1>
        <p class="text-muted small">Управление банковскими счетами</p>
    </div>
    <a asp-action="Create" class="btn btn-primary" style="background: linear-gradient(45deg, #8a2be2, #ff1493); border: none; font-weight: 600;">
        Добавить счёт
    </a>
</div>

<form asp-action="Search" method="get" class="mb-4">
    <div class="input-group" style="max-width: 500px;">
        <input type="text" name="query" class="form-control bg-dark text-white border-secondary" placeholder="Поиск по владельцу..." value="@ViewBag.Query" style="box-shadow: none;" />
        <button type="submit" class="btn btn-outline-light border-secondary">Найти</button>
    </div>
</form>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 text-white" style="background-color: #1e1b2e; border: 1px solid #3f3b54; border-radius: 12px;">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-secondary text-light rounded-pill px-3">ID: @item.Id</span>
                        <span class="badge rounded-pill px-3" 
                              style="background-color: @(item.IsActive ? "rgba(25, 135, 84, 0.2)" : "rgba(220, 53, 69, 0.2)"); 
                                     color: @(item.IsActive ? "#4ade80" : "#f87171");">
                            @(item.IsActive ? "Активен" : "Закрыт")
                        </span>
                    </div>
                    
                    <h5 class="card-title fw-bold mb-3">@item.Number</h5>
                    
                    <div class="mb-2 small text-muted">
                        <strong>Владелец:</strong> <span class="text-light">@item.OwnerName</span>
                    </div>
                    <div class="mb-2 small text-muted">
                        <strong>Тип:</strong> 
                        <span class="text-light">
                            @(item.Type == WtLab4Korbut.Models.AccountType.Savings ? "Сберегательный" : 
                              item.Type == WtLab4Korbut.Models.AccountType.Checking ? "Текущий" : "Срочный вклад")
                        </span>
                    </div>
                    <div class="mb-2 small text-muted">
                        <strong>Баланс:</strong> <span class="text-light">@item.Balance.ToString("N2") руб.</span>
                    </div>
                    <div class="mb-3 small text-muted">
                        <strong>Ставка:</strong> <span class="text-light">@((item.InterestRate * 100).ToString("0.##")) %</span>
                    </div>
                    
                    <div class="mt-auto d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-light btn-sm flex-fill">Подробнее</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-light btn-sm flex-fill">Редактировать</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm flex-fill">Удалить</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>